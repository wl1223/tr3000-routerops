ROUTEROPS_MODE=1
ROUTEROPS_BACKEND=mock
ROUTEROPS_SCENARIO=healthy
ROUTEROPS_DATA_DIR=var
ROUTEROPS_LLM_ENABLED=false
ROUTEROPS_LLM_BASE_URL=https://api.openai.com/v1
ROUTEROPS_LLM_MODEL=gpt-4.1-mini
ROUTEROPS_LLM_API_KEY=
# Set backend=ssh only after pinning the real device host key. Phase 2 is MODE 1 only.
ROUTEROPS_SSH_HOST=
ROUTEROPS_SSH_PORT=22
ROUTEROPS_SSH_USERNAME=root
ROUTEROPS_SSH_AUTH_METHOD=agent
ROUTEROPS_SSH_PASSWORD=
ROUTEROPS_SSH_PRIVATE_KEY=
ROUTEROPS_SSH_HOST_KEY_SHA256=
ROUTEROPS_DEVICE_MODEL_EXPECTATION=Cudy TR3000 v1
ROUTEROPS_DEVICE_FIRMWARE_EXPECTATION=QWRT R26.1.1
# Optional: captures only normalized, redacted observations under var/.
ROUTEROPS_FIXTURE_CAPTURE_DIR=
# Set ROUTEROPS_BACKEND=replay and point this to a reviewed capture.
ROUTEROPS_FIXTURE_REPLAY_DIR=
ROUTEROPS_TELEGRAM_TOKEN=

